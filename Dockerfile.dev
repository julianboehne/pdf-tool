FROM node:22-alpine
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
# Polling required for bind-mounted volumes on macOS/Windows.
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true
EXPOSE 3000
# Invoked through `sh` rather than as an executable: the file arrives over a
# bind mount, where the host's permission bits decide, not the image's.
CMD ["sh", "/app/scripts/dev-entrypoint.sh"]
